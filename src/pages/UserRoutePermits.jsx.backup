import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { 
  Truck, Plus, Clock, CheckCircle, XCircle, DollarSign,
  MapPin, Calendar, Download, Eye, AlertCircle, Navigation,
  FileText, CreditCard
} from 'lucide-react';
import { supabase } from '../lib/supabaseClient';
import { useLanguage, useTheme } from '../contexts/AppContext';
import RoutePermitApplicationModal from '../components/RoutePermitApplicationModal';
import RoutePermitCard from '../components/RoutePermitCard';

const UserRoutePermits = () => {
  const { language } = useLanguage();
  const { theme } = useTheme();
  const [userId, setUserId] = useState(null);
  const [applications, setApplications] = useState([]);
  const [permits, setPermits] = useState([]);
  const [vehicles, setVehicles] = useState([]);
  const [loading, setLoading] = useState(true);
  const [showApplicationModal, setShowApplicationModal] = useState(false);
  const [selectedPermit, setSelectedPermit] = useState(null);
  const [showPermitCard, setShowPermitCard] = useState(false);
  const [paymentLoading, setPaymentLoading] = useState(false);

  useEffect(() => {
    getCurrentUser();
  }, []);

  const getCurrentUser = async () => {
    const { data: { user } } = await supabase.auth.getUser();
    if (user) {
      setUserId(user.id);
      fetchData(user.id);
    }
  };

  const fetchData = async (uid) => {
    try {
      // Fetch applications
      const { data: apps } = await supabase
        .from('route_permit_applications')
        .select(`
          *,
          vehicles(manufacturer, model, vehicle_type)
        `)
        .eq('user_id', uid)
        .order('created_at', { ascending: false });

      // Fetch issued permits
      const { data: perms } = await supabase
        .from('route_permits')
        .select(`
          *,
          vehicles(manufacturer, model, vehicle_type, registration_plate_en)
        `)
        .eq('user_id', uid)
        .order('created_at', { ascending: false });

      // Fetch vehicles
      const { data: vehs } = await supabase
        .from('vehicles')
        .select('*')
        .eq('user_id', uid);

      setApplications(apps || []);
      setPermits(perms || []);
      setVehicles(vehs || []);
    } catch (error) {
      console.error('Error fetching data:', error);
    } finally {
      setLoading(false);
    }
  };

  const handlePayment = async (application) => {
    setPaymentLoading(true);
    try {
      const response = await fetch('https://localhost:3001/create-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount: application.total_fee,
          userId: userId,
          type: 'route_permit',
          metadata: {
            application_id: application.id,
            application_number: application.application_number,
          },
        }),
      });

      const data = await response.json();
      
      if (data.url) {
        window.location.href = data.url;
      } else {
        throw new Error('Payment URL not received');
      }
    } catch (error) {
      console.error('Payment error:', error);
      alert(language === 'bn' ? 'পেমেন্ট শুরু করতে ব্যর্থ' : 'Failed to initiate payment');
    } finally {
      setPaymentLoading(false);
    }
  };

  const getStatusBadge = (status) => {
    const badges = {
      pending: { color: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30', label: language === 'bn' ? 'পেন্ডিং' : 'Pending', icon: Clock },
      approved: { color: 'bg-green-500/20 text-green-400 border-green-500/30', label: language === 'bn' ? 'অনুমোদিত' : 'Approved', icon: CheckCircle },
      rejected: { color: 'bg-red-500/20 text-red-400 border-red-500/30', label: language === 'bn' ? 'প্রত্যাখ্যাত' : 'Rejected', icon: XCircle },
      payment_pending: { color: 'bg-orange-500/20 text-orange-400 border-orange-500/30', label: language === 'bn' ? 'পেমেন্ট পেন্ডিং' : 'Payment Pending', icon: DollarSign },
    };
    return badges[status] || badges.pending;
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin w-12 h-12 border-4 border-emerald-500 border-t-transparent rounded-full mx-auto mb-4"></div>
          <p className="text-slate-400">{language === 'bn' ? 'লোড হচ্ছে...' : 'Loading...'}</p>
        </div>
      </div>
    );
  }

  const stats = {
    totalApplications: applications.length,
    activePermits: permits.filter(p => p.is_active).length,
    pendingApplications: applications.filter(a => a.status === 'pending').length,
    expiringSoon: permits.filter(p => {
      const daysUntilExpiry = Math.ceil((new Date(p.valid_until) - new Date()) / (1000 * 60 * 60 * 24));
      return daysUntilExpiry <= 30 && daysUntilExpiry > 0;
    }).length,
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="mb-8">
          <div className="flex items-center justify-between mb-6">
            <div className="flex items-center gap-3">
              <div className="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl flex items-center justify-center">
                <Truck className="w-6 h-6 text-white" />
              </div>
              <div>
                <h1 className="text-3xl font-bold text-white">
                  {language === 'bn' ? 'আমার রুট পারমিট' : 'My Route Permits'}
                </h1>
                <p className="text-slate-400">
                  {language === 'bn' ? 'আপনার রুট পারমিট আবেদন এবং পারমিট দেখুন' : 'View your route permit applications and permits'}
                </p>
              </div>
            </div>
            <button
              onClick={() => setShowApplicationModal(true)}
              className="px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white rounded-xl font-semibold flex items-center gap-2 transition-all"
            >
              <Plus className="w-5 h-5" />
              {language === 'bn' ? 'নতুন আবেদন' : 'New Application'}
            </button>
          </div>

          {/* Stats */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div className="bg-slate-800/50 border border-slate-700 rounded-xl p-4">
              <p className="text-slate-400 text-sm mb-1">{language === 'bn' ? 'মোট আবেদন' : 'Total Applications'}</p>
              <p className="text-2xl font-bold text-white">{stats.totalApplications}</p>
            </div>
            <div className="bg-green-500/10 border border-green-500/30 rounded-xl p-4">
              <p className="text-green-400 text-sm mb-1">{language === 'bn' ? 'সক্রিয় পারমিট' : 'Active Permits'}</p>
              <p className="text-2xl font-bold text-green-400">{stats.activePermits}</p>
            </div>
            <div className="bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-4">
              <p className="text-yellow-400 text-sm mb-1">{language === 'bn' ? 'পেন্ডিং আবেদন' : 'Pending'}</p>
              <p className="text-2xl font-bold text-yellow-400">{stats.pendingApplications}</p>
            </div>
            <div className="bg-orange-500/10 border border-orange-500/30 rounded-xl p-4">
              <p className="text-orange-400 text-sm mb-1">{language === 'bn' ? 'শীঘ্রই মেয়াদোত্তীর্ণ' : 'Expiring Soon'}</p>
              <p className="text-2xl font-bold text-orange-400">{stats.expiringSoon}</p>
            </div>
          </div>
        </div>

        {/* Active Permits */}
        {permits.filter(p => p.is_active).length > 0 && (
          <div className="mb-8">
            <h2 className="text-xl font-bold text-white mb-4 flex items-center gap-2">
              <CheckCircle className="w-6 h-6 text-emerald-400" />
              {language === 'bn' ? 'সক্রিয় পারমিট' : 'Active Permits'}
            </h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {permits.filter(p => p.is_active).map((permit) => (
                <motion.div
                  key={permit.id}
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  className="bg-gradient-to-br from-emerald-900/30 to-teal-900/30 border border-emerald-500/30 rounded-xl p-6"
                >
                  <div className="flex items-start justify-between mb-4">
                    <div>
                      <h3 className="text-xl font-bold text-white mb-1">{permit.permit_number}</h3>
                      <p className="text-emerald-400">
                        {language === 'bn' ? permit.route_name_bn : permit.route_name_en}
                      </p>
                    </div>
                    <span className="px-3 py-1 bg-green-500/20 text-green-400 border border-green-500/30 rounded-lg text-xs font-semibold">
                      {language === 'bn' ? 'সক্রিয়' : 'Active'}
                    </span>
                  </div>

                  <div className="space-y-2 mb-4">
                    <div className="flex items-center gap-2 text-sm">
                      <MapPin className="w-4 h-4 text-slate-400" />
                      <span className="text-slate-300">{language === 'bn' ? permit.start_location_bn : permit.start_location_en}</span>
                      <span className="text-slate-500">→</span>
                      <span className="text-slate-300">{language === 'bn' ? permit.end_location_bn : permit.end_location_en}</span>
                    </div>
                    <div className="flex items-center gap-2 text-sm">
                      <Truck className="w-4 h-4 text-slate-400" />
                      <span className="text-slate-300">{permit.vehicles?.manufacturer} {permit.vehicles?.model}</span>
                      <span className="text-slate-500">•</span>
                      <span className="text-slate-300">{permit.vehicles?.registration_plate_en}</span>
                    </div>
                    <div className="flex items-center gap-2 text-sm">
                      <Calendar className="w-4 h-4 text-slate-400" />
                      <span className="text-slate-300">
                        {language === 'bn' ? 'মেয়াদ' : 'Valid until'}: {new Date(permit.valid_until).toLocaleDateString(language === 'bn' ? 'bn-BD' : 'en-US')}
                      </span>
                    </div>
                  </div>

                  <button
                    onClick={() => {
                      setSelectedPermit(permit);
                      setShowPermitCard(true);
                    }}
                    className="w-full px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-semibold transition-all flex items-center justify-center gap-2"
                  >
                    <Eye className="w-4 h-4" />
                    {language === 'bn' ? 'পারমিট কার্ড দেখুন' : 'View Permit Card'}
                  </button>
                </motion.div>
              ))}
            </div>
          </div>
        )}

        {/* Applications */}
        <div>
          <h2 className="text-xl font-bold text-white mb-4 flex items-center gap-2">
            <FileText className="w-6 h-6 text-blue-400" />
            {language === 'bn' ? 'আমার আবেদনসমূহ' : 'My Applications'}
          </h2>

          {applications.length === 0 ? (
            <div className="bg-slate-800/50 border border-slate-700 rounded-xl p-12 text-center">
              <AlertCircle className="w-12 h-12 text-slate-500 mx-auto mb-4" />
              <p className="text-slate-400 mb-4">
                {language === 'bn' ? 'কোনো আবেদন পাওয়া যায়নি' : 'No applications found'}
              </p>
              <button
                onClick={() => setShowApplicationModal(true)}
                className="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-semibold"
              >
                {language === 'bn' ? 'প্রথম আবেদন করুন' : 'Create First Application'}
              </button>
            </div>
          ) : (
            <div className="space-y-4">
              {applications.map((app) => {
                const StatusIcon = getStatusBadge(app.status).icon;
                return (
                  <motion.div
                    key={app.id}
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    className="bg-slate-800/50 border border-slate-700 rounded-xl p-6 hover:border-emerald-500/50 transition-all"
                  >
                    <div className="flex flex-col md:flex-row gap-6">
                      <div className="flex-1">
                        <div className="flex items-start justify-between mb-4">
                          <div>
                            <div className="flex items-center gap-3 mb-2">
                              <h3 className="text-xl font-bold text-white">{app.application_number}</h3>
                              <span className={`px-3 py-1 rounded-lg text-xs font-semibold border ${getStatusBadge(app.status).color}`}>
                                <StatusIcon className="w-3 h-3 inline mr-1" />
                                {getStatusBadge(app.status).label}
                              </span>
                            </div>
                            <p className="text-emerald-400">
                              {language === 'bn' ? app.route_name_bn : app.route_name_en}
                            </p>
                          </div>
                        </div>

                        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                          <div>
                            <p className="text-slate-400 text-sm">{language === 'bn' ? 'যানবাহন' : 'Vehicle'}</p>
                            <p className="text-white">{app.vehicles?.manufacturer} {app.vehicles?.model}</p>
                          </div>
                          <div>
                            <p className="text-slate-400 text-sm">{language === 'bn' ? 'দূরত্ব' : 'Distance'}</p>
                            <p className="text-white">{app.distance_km} km</p>
                          </div>
                          <div>
                            <p className="text-slate-400 text-sm">{language === 'bn' ? 'মোট ফি' : 'Total Fee'}</p>
                            <p className="text-white font-bold">৳ {app.total_fee?.toLocaleString()}</p>
                          </div>
                        </div>

                        {app.status === 'rejected' && app.rejection_reason && (
                          <div className="mt-4 bg-red-900/20 border border-red-500/30 rounded-lg p-3">
                            <p className="text-red-400 text-sm">
                              <strong>{language === 'bn' ? 'প্রত্যাখ্যানের কারণ:' : 'Rejection Reason:'}</strong> {app.rejection_reason}
                            </p>
                          </div>
                        )}
                      </div>

                      <div className="flex flex-col gap-3 min-w-[200px]">
                        {app.status === 'approved' && app.payment_status === 'pending' && (
                          <button
                            onClick={() => handlePayment(app)}
                            disabled={paymentLoading}
                            className="w-full px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white rounded-lg font-semibold transition-all disabled:opacity-50 flex items-center justify-center gap-2"
                          >
                            <CreditCard className="w-4 h-4" />
                            {paymentLoading ? (language === 'bn' ? 'প্রক্রিয়াকরণ...' : 'Processing...') : (language === 'bn' ? 'পেমেন্ট করুন' : 'Pay Now')}
                          </button>
                        )}
                        <p className="text-slate-500 text-xs text-center">
                          {new Date(app.created_at).toLocaleDateString(language === 'bn' ? 'bn-BD' : 'en-US')}
                        </p>
                      </div>
                    </div>
                  </motion.div>
                );
              })}
            </div>
          )}
        </div>
      </div>

      {/* Application Modal */}
      <RoutePermitApplicationModal
        isOpen={showApplicationModal}
        onClose={() => setShowApplicationModal(false)}
        userId={userId}
        vehicles={vehicles}
      />

      {/* Permit Card Modal */}
      {showPermitCard && selectedPermit && (
        <RoutePermitCard
          permit={selectedPermit}
          onClose={() => {
            setShowPermitCard(false);
            setSelectedPermit(null);
          }}
        />
      )}
    </div>
  );
};

export default UserRoutePermits;
