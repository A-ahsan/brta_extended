# BRTA Selenium Test Configuration

# Application URL
BASE_URL=http://localhost:3000

# Test User Credentials
TEST_USER_EMAIL=testuser@brta.com
TEST_USER_PASSWORD=Test@123456

# Admin Credentials
TEST_ADMIN_EMAIL=admin@brta.com
TEST_ADMIN_PASSWORD=Admin@123456

# Police Credentials
TEST_POLICE_EMAIL=police@brta.com
TEST_POLICE_PASSWORD=Police@123456

# Vehicle Adder Credentials
TEST_VEHICLE_ADDER_EMAIL=dealer@brta.com
TEST_VEHICLE_ADDER_PASSWORD=Dealer@123456

# Browser Settings
BROWSER=edge
HEADLESS=false
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20
PAGE_LOAD_TIMEOUT=30

# Screenshot Settings
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_DIR=screenshots

# Test Data
TEST_NID=1234567890123
TEST_PHONE=01712345678
TEST_BLOOD_GROUP=A+

# Delays (for visible testing - in seconds)
SHORT_DELAY=1
MEDIUM_DELAY=2
LONG_DELAY=3
